<%= render partial: 'aws_admin/tabs', locals: { selected: 'status' } %>

<% RedmineKitAws::Admin.status_sections.each do |section| %>
<%= render partial: section.partial, locals: { status: @status } %>
<% end %>

<h3><%= l(:label_aws_connection_check) %></h3>

<p><%= link_to l(:button_test), aws_status_check_path, method: :post %></p>

<% if @results %>
<%= render partial: 'aws_admin/values', locals: {
      css: 'checks',
      rows: @results.map { |result|
        { name: l(result.label), ok: result.ok, value: result.detail,
          note: "#{number_with_delimiter(result.milliseconds)} ms" }
      }
    } %>
<% end %>
