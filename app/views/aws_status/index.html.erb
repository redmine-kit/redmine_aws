<%= render partial: 'aws_admin/tabs', locals: { selected: 'status' } %>

<% @status.sections(self).each do |section| %>
<% if section[:partial] %>
<%= render partial: section[:partial], locals: { status: @status } %>
<% else %>
<%= render partial: 'aws_status/section', locals: { section: section } %>
<% end %>
<% end %>

<h3><%= l(:label_aws_connection_check) %></h3>

<p><%= link_to l(:button_test), aws_status_check_path, method: :post %></p>

<% if @results %>
<%= render partial: 'aws_admin/values', locals: { css: 'checks', rows: aws_check_rows(@results) } %>
<% end %>
