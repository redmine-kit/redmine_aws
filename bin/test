#!/usr/bin/env bash
# The plugin's tests in Redmine 7.0.3 on PostgreSQL 16, in Docker.
#   bin/test                 # the plugin's tests, then the Redmine tests around administration
#   bin/test --redmine       # also every Redmine test, with the plugin installed
#   bin/test <files>         # some files of the plugin's tests
#   TEST_RUBY=3.2 bin/test   # on Ruby 3.2 (default 4.0), as the CI also does
#   COVERAGE=1 bin/test      # with the plugin's coverage in coverage/coverage.xml, as the CI does
# Commands that run inside the container are in single quotes on purpose.
# shellcheck disable=SC2016
set -euo pipefail
cd "$(dirname "$0")/.."
image=redmine-aws-test
bin/services >/dev/null
# test/Dockerfile on the Ruby of TEST_RUBY (default 4.0), whose image is
# pinned in test/ruby-<version>.Dockerfile, in place of its FROM ruby line.
ruby=$(sed -n 's/^FROM //p' "test/ruby-${TEST_RUBY:-4.0}.Dockerfile")
dockerfile() {
  sed "s|^FROM ruby:[^ ]*|FROM $ruby|" test/Dockerfile
}
dockerfile | docker buildx build --load -q -t "$image" -f - . >/dev/null
run() {
  docker run --rm --network redmine-aws-test_default -e PARALLEL_WORKERS="${PARALLEL_WORKERS:-4}" "$image" \
    sh -c 'bin/rails db:drop db:create db:migrate db:schema:dump >/dev/null && "$@"' test "$@"
}
# The plugin's tests; with COVERAGE set, in one process with the coverage
# written to coverage/coverage.xml (test/test_helper.rb). COVERAGE itself is not
# passed on: Redmine's test helper would start a SimpleCov of its own.
run_plugin() {
  local cov=(-e PARALLEL_WORKERS="${PARALLEL_WORKERS:-4}")
  if [[ -n "${COVERAGE:-}" ]]; then
    rm -f coverage/.resultset.json && mkdir -p coverage
    cov=(-e PLUGIN_COVERAGE=1 -e PARALLEL_WORKERS=1 -v "$PWD/coverage:/redmine/plugins/redmine_aws/coverage")
  fi
  docker run --rm --network redmine-aws-test_default "${cov[@]}" "$image" \
    sh -c 'bin/rails db:drop db:create db:migrate redmine:plugins:migrate db:schema:dump >/dev/null && "$@"' test "$@"
}
redmine_tests=(test/functional/admin_controller_test.rb test/unit/lib/redmine/plugin_test.rb)
# Redmine's tests that fail with the current gems for known reasons.
known=$(grep -v -e '^#' -e '^$' test/redmine_known_failures.txt | sed 's/[.]/\\./g' | paste -sd '|' -)
if [[ "${1:-}" == "--redmine" ]]; then
  run_plugin bin/rails test plugins/redmine_aws/test
  run bin/rails test --exclude "/^($known)\$/"
elif (($#)); then
  run bin/rails test "${@/#/plugins/redmine_aws/}"
else
  run_plugin bin/rails test plugins/redmine_aws/test
  run bin/rails test "${redmine_tests[@]}"
fi
