#!/usr/bin/env bash
# The plugin as a gem, in Apple container when it runs, else in Docker
# (CONTAINER_CLI=container|docker chooses): builds the gem from this checkout,
# installs it into Redmine 7.0.3 as docs/setup.md#gem says (installed, then
# plugins/redmine_kit_aws linked to the installed gem), and
# boots Redmine through zeitwerk:check and in the production environment,
# which loads every file at start-up (eager_load). It fails when the gem
# misses a file that the checkout has.
#   bin/test-gem
#   TEST_RUBY=3.2 bin/test-gem   # on Ruby 3.2 (default 4.0)
# Commands that run inside the container are in single quotes on purpose.
# shellcheck disable=SC2016
set -euo pipefail
cd "$(dirname "$0")/.."
source bin/container_cli
source bin/test_slot
name=redmine-kit-aws-test
bin/services >/dev/null
source bin/test_image
if [[ "$cli" == docker ]]; then
  net=(--network redmine-kit-aws-test_default)
else
  net=(--network "$kit_test_network" -m 4G
    -e TEST_DATABASE_HOST="$(container_address redmine-kit-aws-test-postgres)")
fi
# Two ways the gem comes into Redmine: as docs/setup.md#gem says, installed
# but not required by Bundler (a dependency of another plugin's gem, or
# require: false), so that Rails' code loader loads lib/redmine_kit/aws.rb through
# plugins/; and required early by Bundler (gem 'redmine_kit_aws'), as a plugin's
# boot/ file may do. A database of this run's own, dropped at the end.
"$cli" run --rm "${run_opts[@]}" "${net[@]}" -e TEST_DATABASE="redmine_test_$$" "$image" sh -ec '
  (cd plugins/redmine_kit_aws && gem build --quiet redmine_kit_aws.gemspec --output /tmp/redmine_kit_aws.gem)
  rm -rf plugins/redmine_kit_aws
  gem install --local --no-document --quiet /tmp/redmine_kit_aws.gem
  # The production environment, which loads every file at start-up
  # (eager_load), on the test database.
  printf "%s\n" "production:" "  adapter: postgresql" "  host: ${TEST_DATABASE_HOST:-postgres}" "  database: $TEST_DATABASE" \
    "  username: postgres" >> config/database.yml
  for line in "gem '\''redmine_kit_aws'\'', require: false" "gem '\''redmine_kit_aws'\''"; do
    echo "== Gemfile.local: $line"
    printf "%s\n" "$line" "gem '\''simplecov-cobertura'\'', group: :test" > Gemfile.local
    bundle install --prefer-local --quiet
    ln -sfn "$(bundle info --path redmine_kit_aws)" plugins/redmine_kit_aws
    bin/rails db:drop db:create db:migrate redmine:plugins:migrate >/dev/null
    bin/rails zeitwerk:check
    RAILS_ENV=production SECRET_KEY_BASE=test-gem bin/rails runner "
      plugin = Redmine::Plugin.find(:redmine_kit_aws)
      dir = File.realpath(plugin.directory)
      abort %(redmine_kit_aws is not the installed gem: #{dir}) unless dir.start_with?(Gem.dir)
      abort %(not eager loaded) unless Rails.application.config.eager_load
      puts %(redmine_kit_aws #{plugin.version} from #{dir}: #{RedmineKit::Aws::Admin.tabs.map(&:name).join(%(, ))})"
  done
  bin/rails db:drop >/dev/null'
